NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_DIR=uploads
UPLOAD_PUBLIC_BASE_URL=https://localhost:3000/uploads
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880
UPLOAD_MAX_VIDEO_SIZE_BYTES=26214400
UPLOAD_PENDING_TTL_HOURS=24
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=threads-like
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
AI_MODERATION_BASE_URL=http://localhost:8000
AI_MODERATION_TIMEOUT_MS=5000
MODEL_DIR=
MODEL_NAME=
