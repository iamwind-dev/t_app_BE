NODE_ENV=production
PORT=10000
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"
JWT_ACCESS_SECRET="change_me"
JWT_REFRESH_SECRET="change_me"
JWT_ACCESS_EXPIRES_IN=1h
AI_SERVICE_URL="https://your-ai-service.hf.space"
AI_SERVICE_TIMEOUT_MS=30000
CORS_ORIGIN="*"
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_LOCAL_DIR=uploads
UPLOAD_PUBLIC_BASE_URL="https://your-backend.onrender.com/uploads"
UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880

UPLOAD_MAX_VIDEO_SIZE_BYTES=26214400
UPLOAD_PENDING_TTL_HOURS=24

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=threads-like
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

CHAT_ENABLE_LEGACY_CONVERSATION_ROOM=true
INTERNAL_OPS_TOKEN=
